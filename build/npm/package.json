  "keywords": [
    "prometheus",
    "promql",
    "metrics",
    "monitoring",
    "observability",
    "alerting",
    "timeseries",
    "cli",
    "agent",
    "claude"
  ],
  "homepage": "https://github.com/AngelMsger/prometheus-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngelMsger/prometheus-cli.git"
  },
  "license": "MIT",
  "bin": {
    "prometheus-cli": "bin/prometheus-cli.js"
  },
  "main": "install.js",
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test install.test.js"
  },
  "files": [
    "bin/",
    "install.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
