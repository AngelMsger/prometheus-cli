# prometheus-cli environment configuration
# Copy to .env and fill in. All variables are optional and overridable by CLI flags.

# Prometheus server root — the part BEFORE /api/v1
# (also works for Thanos Query, Cortex/Mimir and VictoriaMetrics)
PROMETHEUS_URL=http://localhost:9090

# --- Authentication -----------------------------------------------------------
# Prometheus itself has no accounts, so the default scheme is `none` and nothing
# below is needed for a server reachable on its own port. Set a secret only when
# a proxy, gateway or hosted endpoint sits in front of it.

# none | basic | bearer  (inferred from whichever secret is set below)
PROMETHEUS_AUTH_SCHEME=none

# bearer: a token from the hosting product or a Kubernetes service account
PROMETHEUS_TOKEN=

# basic: a username + password issued by the gateway in front of Prometheus
PROMETHEUS_USER=
PROMETHEUS_PASSWORD=

# Your team's credential page, shown by `auth guide` (display only, never fetched)
PROMETHEUS_CREDENTIAL_URL=

# Multi-tenant backends only (Cortex, Mimir, Thanos Receive): sent as X-Scope-OrgID.
# A missing tenant returns an EMPTY RESULT rather than an error, so set it when
# the backend is multi-tenant.
PROMETHEUS_TENANT=

# --- Behaviour ----------------------------------------------------------------

# Default output format: json | table | ndjson
PROMETHEUS_FORMAT=json

# Use a named context for this process (see `config contexts`)
PROMETHEUS_CONTEXT=

# Session read-only posture (1 to block the TSDB admin writes before they leave the CLI)
PROMETHEUS_CLI_READ_ONLY=

# Set to 1 to silence the "a newer release is available" notice on stderr
PROMETHEUS_CLI_NO_UPDATE_NOTIFIER=

# Agents: export the loaded companion Skill's version to complete the handshake
PROMETHEUS_CLI_SKILL=

# Set to 1 to silence the "load the companion Skill" notice on stderr
PROMETHEUS_CLI_NO_SKILL_HINT=

# Set to 1 to silence the multi-context reminder on stderr
PROMETHEUS_CLI_NO_CONTEXT_HINT=
